# Coupling rules (tools/check/parity.json, docs/FEATURES.md) with this commit's trailers:
#   Parity-skip: <group>: <reason>     Features-skip: <reason>
# A normal commit gets reminders (the counterpart may follow on the branch); a MERGE commit is judged on the
# whole incoming branch and fails, which is what keeps Android-only graph/alert changes out of the integration branch.
exec "$(git rev-parse --show-toplevel)/tools/check/run.sh" --only coupling --commit-msg "$1"
