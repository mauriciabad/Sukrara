<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Libre 3 link (connect by address from the NFC tap: no scanning, so no BLUETOOTH_SCAN / location). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Starting / taking over a Libre 3 with one tap. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- LibreView sign-in (receiver ID) and Juggluco's local web server (loopback). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application>
        <!-- Android 17: NFC intents reach only activities protected by DISPATCH_NFC_MESSAGE. Declared disabled:
             the new-sensor screen reads taps with reader mode. -->
        <activity
            android:name=".SensorTapActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DISPATCH_NFC_MESSAGE"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_libre" />
        </activity>
    </application>
</manifest>
