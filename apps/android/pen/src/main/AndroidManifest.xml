<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- disabled until chunk 19; then enabled at runtime only while pens are on -->
        <activity
            android:name=".PenTapActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DISPATCH_NFC_MESSAGE"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_pen" />
        </activity>
        <activity
            android:name=".PenReadActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="" />
    </application>
</manifest>
