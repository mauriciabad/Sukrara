<!-- NovoPen 6 / Echo Plus: an NFC Forum Type 4 tag whose NDEF check times out, so it is dispatched as IsoDep + NfcA.
     This also matches bank/transit cards: the read activity finishes silently for any tag that isn't a pen. -->
<resources>
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>
</resources>
