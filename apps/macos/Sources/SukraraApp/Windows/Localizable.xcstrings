    "A Focus (Do Not Disturb, Sleep…) can hold back Sukrara's alarms on this Mac. Allow Sukrara in each Focus, and keep the phone as the alarm." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Focus (Do Not Disturb, Sleep…) can hold back Sukrara's alarms on this Mac. Allow Sukrara in each Focus, and keep the phone as the alarm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modo de concentración (No molestar, Dormir…) puede retener las alarmas de Sukrara en este Mac. Permite Sukrara en cada modo y deja que el móvil sea la alarma."
          }
