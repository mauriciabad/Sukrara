{
  "_about": [
    "THE settings schema (round f28, 2026-10-21): every user setting of Sukrara for Android and Mac, so the platforms",
    "can't drift apart. 'numbers' are the number formats (stored units; valid = a preset, a special value, or a custom",
    "value in min..max on step; 'scale' = stored units per shown unit, 'nudge' = one stepper click). 'settings' is the",
    "inventory: each entry exists on both platforms (android + mac stores/keys) or names the one platform in 'only'",
    "with the reason. 'mirror' = a follower in 'Settings from: Wearer' takes the wearer's value ('wire' = its key in",
    "the wearer's settings event, spikes/nostr/PROTOCOL-v2.md); everything else is per device.",
    "Generated code: tools/settings/gen.py writes SettingsSpec.kt (Android) and SettingsSpec.swift (Mac); tools/check",
    "rule 'settings' fails on a stale file, an entry without both platforms or a reason, a stored key missing from the",
    "schema, or a number input that doesn't take its spec. SettingsSchemaTest (Android) and -settingsselftest (Mac)",
    "test the models against it."
  ],
  "options": {
    "_about": "Option lists both platforms offer (the user, 2026-10-21: option lists must not diverge either). Each platform's list is tested against these values in order (SettingsSchemaTest, -settingsselftest); a value one platform can't offer goes in 'only' with the reason.",
    "exportPeriod": {"values": ["sensor", "7", "14", "30", "all"], "label": "Export data: this sensor, 7 / 14 / 30 days, all time"},
    "reportPeriod": {"values": ["1", "7", "14", "30"], "label": "Glucose report: 1 / 7 / 14 / 30 days"},
    "slotKind": {"values": ["TIR", "GMI", "AVERAGE", "CV"], "label": "What a slot beside the value shows"},
    "tirRange": {"values": ["IN_RANGE", "TIGHT"], "label": "What a ring's centre counts"},
    "lastPlace": {"values": ["OFF", "NEAR_VALUE", "END"], "label": "Last treatment position"},
    "soundPack": {"values": ["arcade", "kart", "quest", "soft", "system", "none"], "label": "Sound packs (and per alert)"},
    "settingsFrom": {"values": ["wearer", "default", "custom"], "label": "Followers: Settings from"},
    "markKind": {"values": ["rapid", "long", "carbs", "note"], "label": "Treatments on the graph: the kinds, in label order"},
    "markPart": {"values": ["point", "line", "amount", "time"], "label": "Treatments on the graph: what each kind can show (the marker, the mute line, the amount label, the time label)"},
    "markParts.rapid": {"values": ["point", "line", "amount", "time"], "label": "Rapid insulin: every part"},
    "markParts.long": {"values": ["point", "amount", "time"], "label": "Long-acting insulin: no mute line (it mutes nothing)"},
    "markParts.carbs": {"values": ["point", "line", "amount", "time"], "label": "Carbs: every part"},
    "markParts.note": {"values": ["point"], "label": "Notes: only the marker (no amount, mutes nothing)"},
    "markDefault.rapid": {"values": ["point", "line", "amount", "time"], "label": "Rapid insulin by default: everything"},
    "markDefault.long": {"values": ["point", "amount", "time"], "label": "Long-acting by default: everything"},
    "markDefault.carbs": {"values": ["point"], "label": "Carbs by default: only the point (the user, 2026-10-21)"},
    "markDefault.note": {"values": ["point"], "label": "Notes by default: the marker"}
  },
  "numbers": {
    "bandVeryLow":   {"unit": "mg/dL", "min": 30, "max": 80, "step": 1, "nudge": 1, "presets": [50, 54, 55, 60], "default": 54},
    "bandLow":       {"unit": "mg/dL", "min": 40, "max": 120, "step": 1, "nudge": 1, "presets": [65, 70, 75, 80], "default": 70},
    "bandTight":     {"unit": "mg/dL", "min": 80, "max": 250, "step": 1, "nudge": 1, "presets": [120, 140, 160], "default": 140},
    "bandHigh":      {"unit": "mg/dL", "min": 100, "max": 300, "step": 1, "nudge": 1, "presets": [160, 180, 200], "default": 180},
    "bandVeryHigh":  {"unit": "mg/dL", "min": 150, "max": 400, "step": 1, "nudge": 1, "presets": [220, 250, 300], "default": 250},
    "bandExtremelyHigh": {"unit": "mg/dL", "min": 200, "max": 450, "step": 1, "nudge": 1, "presets": [300, 350, 400], "default": 300},
    "graphHours":    {"unit": "h", "min": 1, "max": 48, "step": 1, "nudge": 1, "presets": [3, 6, 12, 24], "default": 12},
    "placeHours":    {"unit": "h", "min": 1, "max": 48, "step": 1, "nudge": 1, "presets": [3, 6, 12, 24], "default": 0,
                      "special": {"0": "same_as_default"}},
    "ringCount":     {"unit": "", "min": 0, "max": 3, "step": 1, "nudge": 1, "presets": [0, 1, 2, 3], "default": 2, "custom": false,
                      "special": {"0": "none"}},
    "ringWindow":    {"unit": "d", "scale": 86400, "min": 86400, "max": 7776000, "step": 86400, "nudge": 86400,
                      "presets": [43200, 86400, 259200, 604800, 1209600, 2592000], "default": 86400},
    "line":          {"unit": "mg/dL", "min": 40, "max": 400, "step": 1, "nudge": 5, "presets": [], "default": 100, "maxItems": 6},
    "gridHours":     {"unit": "h", "min": 0, "max": 12, "step": 1, "nudge": 1, "presets": [0, 1, 2, 3, 4, 6, 12], "default": 1, "custom": false,
                      "special": {"0": "off"}},
    "countdownHours": {"unit": "h", "min": 1, "max": 24, "step": 1, "nudge": 1, "presets": [2, 4, 8, 12, 24], "default": 8},
    "thresholdVeryLow":  {"unit": "mg/dL", "min": 40, "max": 80, "step": 1, "nudge": 1, "presets": [50, 54, 55, 60, 65], "default": 55},
    "thresholdLow":      {"unit": "mg/dL", "min": 50, "max": 120, "step": 1, "nudge": 1, "presets": [60, 65, 70, 75, 80], "default": 70},
    "thresholdHigh":     {"unit": "mg/dL", "min": 120, "max": 300, "step": 1, "nudge": 5, "presets": [160, 170, 180, 185, 200], "default": 180},
    "thresholdVeryHigh": {"unit": "mg/dL", "min": 150, "max": 400, "step": 1, "nudge": 5, "presets": [200, 220, 250, 270, 300], "default": 250},
    "thresholdExtremelyHigh": {"unit": "mg/dL", "min": 200, "max": 450, "step": 1, "nudge": 5, "presets": [220, 250, 270, 300, 350], "default": 300},
    "thresholdRate":     {"unit": "mg/dL/min", "min": 0.5, "max": 5, "step": 0.1, "nudge": 0.5, "decimals": 1, "presets": [1, 1.5, 2, 2.5, 3], "default": 2},
    "thresholdNoData":   {"unit": "min", "min": 5, "max": 240, "step": 1, "nudge": 5, "presets": [10, 15, 20, 30, 60], "default": 20},
    "alertRepeat":   {"unit": "min", "min": 1, "max": 240, "step": 1, "nudge": 5, "presets": [0, 5, 10, 15, 30, 60, 120], "default": 5,
                      "special": {"0": "once"}},
    "muteInsulin":   {"unit": "min", "min": 10, "max": 360, "step": 1, "nudge": 15, "presets": [30, 45, 60, 90, 120, 180], "default": 60},
    "muteFalling":   {"unit": "min", "min": 5, "max": 120, "step": 1, "nudge": 5, "presets": [10, 15, 20, 30, 45, 60], "default": 20},
    "muteCarbs":     {"unit": "min", "min": 5, "max": 120, "step": 1, "nudge": 5, "presets": [10, 15, 20, 30, 45], "default": 15},
    "actionMute":    {"unit": "min", "min": 1, "max": 720, "step": 1, "nudge": 5, "presets": [15, 30, 60, 120], "default": 30},
    "actionSlow":    {"unit": "min", "min": 5, "max": 120, "step": 1, "nudge": 5, "presets": [15, 20, 30, 45, 60, 90, 120], "default": 30,
                      "dynamic": "only values slower than every enabled level alert's repeat (AlertSettings.slowChoices / slowFloor)"},
    "nostrInterval": {"unit": "min", "min": 1, "max": 120, "step": 1, "nudge": 5, "presets": [0, 5, 15, 30], "default": 0,
                      "special": {"0": "every_reading"}},
    "libreviewInterval": {"unit": "min", "min": 1, "max": 240, "step": 1, "nudge": 5, "presets": [5, 15, 60], "default": 5}
  },
