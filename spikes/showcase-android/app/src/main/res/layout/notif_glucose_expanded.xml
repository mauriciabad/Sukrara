<?xml version="1.0" encoding="utf-8"?>
<!-- CGM research spikes — https://github.com/mauriciabad/cgm-reading-mac-spike — GPL-3.0-or-later.
     Glucose card, expanded (chip off): value, arrow, the reading's time when late and the slots on one row, the graph
     at the column's full width below (scaled uniformly). The follower line is the header's sub text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <!-- the value as a picture: the card's rounded face (graph/RoundedFont.kt), which RemoteViews text can't use -->
        <ImageView android:id="@+id/value"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <ImageView android:id="@+id/arrow"
            android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="6dp"
            android:importantForAccessibility="no" />

        <TextView android:id="@+id/info"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />

        <ImageView android:id="@+id/slots"
            android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="8dp"
            android:adjustViewBounds="true" android:scaleType="fitEnd" android:importantForAccessibility="no" />
    </LinearLayout>

    <ImageView android:id="@+id/graph"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:adjustViewBounds="true" android:scaleType="fitCenter" android:importantForAccessibility="no" />
</LinearLayout>
