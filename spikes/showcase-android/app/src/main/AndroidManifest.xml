<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- relays over wss; owner: Juggluco's web server on 127.0.0.1 (cleartext, loopback only) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      connectedDevice instead of dataSync: on Android 15+ a dataSync FGS is capped at 6 h per 24 h. Its prerequisite
      CHANGE_NETWORK_STATE is a normal (install-time) permission, so no Bluetooth permission is required.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- investigation 05: Live Update chip (promoted ongoing notification) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Settings: a sound test plays the alert's vibration too -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Investigation 15: the alert timer wakes exactly when a mute window ends (Alerts.schedule) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- restart the wearer service after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- investigation 07: BLE transport (owner = GATT server + advertiser, follower = central); no location use -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- follower: scanning the invite QR code -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- sensor end in calendar (opt-in setting): Sukrara's own calendar or one the user picks -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Libre 3: start or take over a sensor with an NFC tap (ui/SensorScreen, direct/Libre3Nfc) -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- investigation 22: Health Connect blood glucose (opt-in switch in Share with apps) -->
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />

    <!-- Only this app may feed the SystemUI hook (status/RootStatusBar → hook/SystemUiHook). -->
    <permission
        android:name="app.mauri.sukrara.poc.permission.STATUS_BAR_GLUCOSE"
        android:protectionLevel="signature" />
    <uses-permission android:name="app.mauri.sukrara.poc.permission.STATUS_BAR_GLUCOSE" />

    <!-- Sensor end in calendar: the settings hint shows only when Google Calendar is installed (and opens it) -->
    <queries>
        <package android:name="com.google.android.calendar" />
        <!-- investigation 22: which apps declare a receiver for Sukrara's broadcasts (bridge/AppBroadcasts) -->
        <intent><action android:name="com.eveningoutpost.dexdrip.BgEstimate" /></intent>
        <intent><action android:name="com.librelink.app.ThirdPartyIntegration.GLUCOSE_READING" /></intent>
        <intent><action android:name="com.librelink.app.ThirdPartyIntegration.SENSOR_ACTIVATE" /></intent>
        <intent><action android:name="glucodata.Minute" /></intent>
        <!-- apps whose real icon settings rows show (ui/AppIcons Service) and apps that read the xDrip+ server
             (bridge/ServerReaders) -->
        <package android:name="tk.glucodata" />
        <package android:name="com.eveningoutpost.dexdrip" />
        <package android:name="com.google.android.healthconnect.controller" />
        <package android:name="com.android.healthconnect.controller" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.garmin.connectiq" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Sukrara">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- sukrara:join#<32 chars>: the web page's "Open in Sukrara" button where App Links aren't verified -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sukrara" />
            </intent-filter>
            <!-- App Link invites: https://sukrara.mauri.app/join#<32 chars> (v3 short link; assetlinks.json on the site) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="sukrara.mauri.app" />
                <data android:pathPrefix="/join" />
            </intent-filter>
        </activity>
        <!-- Android 14+: Health Connect grants health permissions only to apps that show their privacy rationale -->
        <activity-alias
            android:name=".ui.HealthPermissionsRationale"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Tapping a Libre sensor while Sukrara isn't in front opens it (Sensor screen switch, ui/NfcLaunch). The Sensor
             screen's reader mode still takes the tap first when it's open. -->
        <activity-alias
            android:name=".ui.NfcLaunch"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_libre" />
        </activity-alias>
        <!-- the quick treatment dialog: a tap on a widget or the glucose notification opens it over any app, and over
             the lock screen (inv. 17: SystemUI reads showWhenLocked from the manifest to skip the unlock) -->
        <activity
            android:name=".ui.QuickTreatmentActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sukrara.Quick"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <!-- investigation 17: Quick Settings tile "Add treatment" (works from the lock screen, no root) -->
        <service
            android:name=".ui.TreatmentTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_sukrara"
            android:label="@string/tile_treatment"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <service
            android:name=".owner.OwnerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".follower.FollowerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <receiver
            android:name=".follower.WatchdogReceiver"
            android:exported="false" />
        <!-- Investigation 15: glucose alerts. The channels' sound URIs point at this provider, which SystemUI opens on
             every alert (pack + random variant chosen at play time). Exported without a permission so SystemUI can
             read it (NotificationRecord's grant check); it only serves the bundled alert sounds. -->
        <provider
            android:name=".alerts.AlertSoundProvider"
            android:authorities="${applicationId}.alertsound"
            android:exported="true" />
        <receiver
            android:name=".alerts.AlertCheckReceiver"
            android:exported="false" />
        <!-- the latest reading's next freshness step (90 s / 5 min / 20 min / 3 h): every surface redraws without a reading -->
        <receiver
            android:name=".status.FreshnessTicker$Receiver"
            android:exported="false" />
        <!-- Mute / Slow down / Mute for… on an alert notification (PendingIntents only) -->
        <receiver
            android:name=".alerts.AlertActionReceiver"
            android:exported="false" />
        <!-- Allow / Deny on the access-request notification (PendingIntents only) -->
        <receiver
            android:name=".owner.RequestActionReceiver"
            android:exported="false" />
        <!-- adb-only feature switches (battery lab, investigation 11): DUMP is held by the shell, not by apps -->
        <receiver
            android:name=".features.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- investigation 16: one widget placement's own window / rings (touch & hold → Reconfigure) -->
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- investigation 12: home-screen widgets (Glance) -->
        <receiver
            android:name=".widgets.ValueWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_value">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_value" />
        </receiver>
        <receiver
            android:name=".widgets.GraphWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_graph">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_graph" />
        </receiver>
        <receiver
            android:name=".widgets.CombinedWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_combined">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined" />
        </receiver>
        <!-- the home screen's "add the widget" banner: requestPinAppWidget's success callback (PendingIntent only) -->
        <receiver
            android:name=".widgets.WidgetPresence$PinnedReceiver"
            android:exported="false" />
        <!-- investigation 17: the lock screen widget, hosted by the LSPosed module inside SystemUI -->
        <receiver
            android:name=".widgets.LockscreenWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lockscreen">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lockscreen" />
        </receiver>
        <!-- Settings → Export data: the CSV handed to the share sheet (export/Export.kt, cache/export/ only) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
        <!-- widgets/WidgetProbe.kt: measures the size the launcher really gives a graph widget -->
        <provider
            android:name=".widgets.ProbeProvider"
            android:authorities="${applicationId}.widgetprobe"
            android:exported="true" />
        <receiver
            android:name=".widgets.StartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- sensorend/SensorEnd.kt: reminder / countdown alarm, countdown dismissed, and re-planning after boot,
             an app update, a clock or time-zone change (exempt implicit broadcasts) -->
        <receiver
            android:name=".sensorend.SensorEndReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <!-- Also an LSPosed module (libxposed API 102, scope System UI): see resources/META-INF/xposed/.
             SystemUI with the module loaded asks for the current value when it (re)starts. -->
        <receiver
            android:name="app.mauri.sukrara.status.RootStatusBar$HelloReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.mauri.sukrara.poc.HOOK_HELLO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
