{
  "about": "Card decisions shared by Android (GraphFixtureTest.kt) and Mac (Sukrara -graphselftest). Format: README.md.",
  "cases": [
    {"name": "low muted from the notification: the same faded badge, carbs colour",
     "reading": {"t": -60, "sgv": 65}, "treatments": [], "paused": {"low": 600},
     "expect": {"status": "paused:low", "until": 600,
                "badge": {"kind": "carbs", "text": "10m left", "short": "10m", "tonal": true}, "last": null}},
    {"name": "high muted from the notification: insulin colour",
     "reading": {"t": -60, "sgv": 200}, "treatments": [], "paused": {"high": 1500},
     "expect": {"status": "paused:high", "until": 1500,
                "badge": {"kind": "rapid", "text": "25m left", "short": "25m", "tonal": true}, "last": null}},
    {"name": "a notification mute never covers very low",
     "reading": {"t": -60, "sgv": 50}, "treatments": [], "paused": {"low": 600},
     "expect": {"status": "needed:very_low", "badge": {"kind": "carbs", "text": "Eat carbs", "short": "Carbs", "tonal": false}, "last": null}},
    {"name": "a notification mute that has ended: needed again",
     "reading": {"t": -60, "sgv": 65}, "treatments": [], "paused": {"low": 0},
     "expect": {"status": "needed:low", "badge": {"kind": "carbs", "text": "Eat carbs", "short": "Carbs", "tonal": false}, "last": null}},
    {"name": "carbs and a notification mute: the carbs' mute shows",
     "reading": {"t": -60, "sgv": 65}, "treatments": [{"id": "c1", "k": "carbs", "a": 15, "t": -300}], "paused": {"low": 1800},
     "expect": {"status": "taken:low:c1", "until": 600,
                "badge": {"kind": "carbs", "text": "10m left", "short": "10m", "tonal": true}, "last": {"id": "c1", "until": 600}}},
    {"name": "in range: no badge, no slot",
     "reading": {"t": -60, "sgv": 120}, "treatments": [],
     "expect": {"status": "none", "badge": null, "last": null}},
    {"name": "high, nothing logged: take insulin",
     "reading": {"t": -60, "sgv": 200}, "treatments": [],
     "expect": {"status": "needed:high", "badge": {"kind": "rapid", "text": "Take insulin", "short": "Insulin", "tonal": false}, "last": null}},
    {"name": "high, insulin 20 min ago mutes it for 40 more minutes",
     "reading": {"t": -60, "sgv": 200}, "treatments": [{"id": "i1", "k": "rapid", "a": 2, "t": -1200}],
     "expect": {"status": "taken:high:i1", "until": 2400,
                "badge": {"kind": "rapid", "text": "40m left", "short": "40m", "tonal": true},
                "last": {"id": "i1", "until": 2400}, "amounts": {"i1": "2u"}}},
    {"name": "low, carbs 30 min ago (mute over): eat carbs, carbs stay in the slot",
     "reading": {"t": -60, "sgv": 65}, "treatments": [{"id": "c1", "k": "carbs", "a": 15, "t": -1800}],
     "expect": {"status": "needed:low", "badge": {"kind": "carbs", "text": "Eat carbs", "short": "Carbs", "tonal": false},
                "last": {"id": "c1", "until": -900}, "amounts": {"c1": "15g"}}},
    {"name": "extremely high is never muted",
     "reading": {"t": -60, "sgv": 320}, "treatments": [{"id": "r1", "k": "rapid", "a": 3, "t": -600}],
     "expect": {"status": "needed:extremely_high", "badge": {"kind": "rapid", "text": "Take insulin", "short": "Insulin", "tonal": false},
                "last": {"id": "r1", "until": 3000}}},
    {"name": "meal logged as insulin + carbs in the same minute: the slot shows the insulin",
     "reading": {"t": -60, "sgv": 150},
     "treatments": [{"id": "m1", "k": "carbs", "a": 40, "t": -3000}, {"id": "m2", "k": "rapid", "a": 4.5, "t": -3000}],
     "expect": {"status": "none", "badge": null, "last": {"id": "m2", "until": 600}, "amounts": {"m1": "40g", "m2": "4.5u"}}},
    {"name": "a stale reading never shows a badge",
     "reading": {"t": -1000, "sgv": 250}, "treatments": [],
     "expect": {"status": "none", "badge": null, "last": null}},
    {"name": "mute after insulin off: still needed, slot without a mute",
     "settings": {"muteAfterInsulin": {"on": false, "min": 60}},
     "reading": {"t": -60, "sgv": 200}, "treatments": [{"id": "r2", "k": "rapid", "a": 1.5, "t": -600}],
     "expect": {"status": "needed:high", "badge": {"kind": "rapid", "text": "Take insulin", "short": "Insulin", "tonal": false},
                "last": {"id": "r2", "until": null}, "amounts": {"r2": "1.5u"}}},
    {"name": "long-acting insulin and notes never fill the slot",
     "reading": {"t": -60, "sgv": 110},
     "treatments": [{"id": "l1", "k": "long", "a": 18, "t": -600}, {"id": "n1", "k": "note", "a": 0, "t": -300, "n": "walk"}],
     "expect": {"status": "none", "badge": null, "last": null, "amounts": {"l1": "18u", "n1": null}}}
  ]
}
