{
 "about": "The mark a time-in-range ring wears and the % column's crown (TirMark in graph/GlucoseCard.kt; TirMark in SukraraGraph.swift). `tir`: shares per band + coverage of the window; `range`: inRange | tight. expect: `mark` none | laurel (≥ 90 %) | flowers (≥ 95 %) | crown (100 %), `text` the ring's number, `column` [below, in range, above] as the % column shows them, `crown` whether its 100 wears the crown, `flower` the laurel's flower (none | lavender 95 | forget_me_not 96 | daisy 97 | cherry 98 | rosette 99 and 100). Format: ../README.md.",
 "cases": [
  {"name": "all in range, enough data: crown", "tir": {"tight": 0.737, "target": 0.263, "coverage": 0.9}, "range": "inRange", "expect": {"mark": "crown", "text": "100", "column": [0, 100, 0], "crown": true, "flower": "rosette"}},
  {"name": "all in range but under 70 % data: no mark", "tir": {"tight": 0.8, "target": 0.2, "coverage": 0.6}, "range": "inRange", "expect": {"mark": "none", "text": "100", "column": [0, 100, 0], "crown": false, "flower": "none"}},
  {"name": "70 % data is enough", "tir": {"tight": 0.5, "target": 0.5, "coverage": 0.7}, "range": "inRange", "expect": {"mark": "crown", "text": "100", "column": [0, 100, 0], "crown": true, "flower": "rosette"}},
  {"name": "0.4 % low: flowers, 99.6, the column gives the low its 1", "tir": {"low": 0.004, "tight": 0.7, "target": 0.296, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "flowers", "text": "99.6", "column": [1, 99, 0], "crown": false, "flower": "rosette"}},
  {"name": "1 % high: flowers", "tir": {"tight": 0.69, "target": 0.3, "high": 0.01, "coverage": 0.95}, "range": "inRange", "expect": {"mark": "flowers", "text": "99", "column": [0, 99, 1], "crown": false, "flower": "rosette"}},
  {"name": "94.6 % shows 95: flowers", "tir": {"low": 0.02, "tight": 0.6, "target": 0.346, "high": 0.034, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "flowers", "text": "95", "column": [2, 95, 3], "crown": false, "flower": "lavender"}},
  {"name": "94.4 % shows 94: laurel", "tir": {"low": 0.02, "tight": 0.6, "target": 0.344, "high": 0.036, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "laurel", "text": "94", "column": [2, 94, 4], "crown": false, "flower": "none"}},
  {"name": "very good ring: 96 % very good is flowers while in range is all (column crowned)", "tir": {"tight": 0.96, "target": 0.04, "coverage": 1.0}, "range": "tight", "expect": {"mark": "flowers", "text": "96", "column": [0, 100, 0], "crown": true, "flower": "forget_me_not"}},
  {"name": "very good ring: all very good is a crown", "tir": {"tight": 1.0, "coverage": 0.8}, "range": "tight", "expect": {"mark": "crown", "text": "100", "column": [0, 100, 0], "crown": true, "flower": "rosette"}},
  {"name": "5 % very low: shows 95, but the lows' goals are missed: no mark", "tir": {"veryLow": 0.05, "tight": 0.9, "target": 0.05, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "none", "text": "95", "column": [5, 95, 0], "crown": false, "flower": "none"}},
  {"name": "90 % shows 90: laurel", "tir": {"low": 0.02, "tight": 0.6, "target": 0.3, "high": 0.08, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "laurel", "text": "90", "column": [2, 90, 8], "crown": false, "flower": "none"}},
  {"name": "89.4 % shows 89: no mark", "tir": {"low": 0.02, "tight": 0.594, "target": 0.3, "high": 0.086, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "none", "text": "89", "column": [2, 89, 9], "crown": false, "flower": "none"}},
  {"name": "92 % with 4.6 % below: the lows' goal is missed, no laurel", "tir": {"low": 0.046, "tight": 0.6, "target": 0.32, "high": 0.034, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "none", "text": "92", "column": [5, 92, 3], "crown": false, "flower": "none"}},
  {"name": "97 % shows 97: daisy", "tir": {"low": 0.01, "tight": 0.7, "target": 0.27, "high": 0.02, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "flowers", "text": "97", "column": [1, 97, 2], "crown": false, "flower": "daisy"}},
  {"name": "98 % shows 98: cherry", "tir": {"tight": 0.7, "target": 0.28, "high": 0.02, "coverage": 1.0}, "range": "inRange", "expect": {"mark": "flowers", "text": "98", "column": [0, 98, 2], "crown": false, "flower": "cherry"}}
 ]
}
