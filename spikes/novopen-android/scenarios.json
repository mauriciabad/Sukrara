{
  "_doc": "Pen dose engine scenarios (DESIGN.md §3–§4, PRODUCT.md §3). Run by spikes/novopen-android PenScenarioTest and Sukrara's copy of it. Times: 'HH:MM[:SS]' on day D0 (2026-10-20 UTC) or 'D-n HH:MM'. A scan reads the pen's whole memory ('add' = doses dosed since the previous step; a third element \"inc\" = flagged incomplete). Expected entries = the live log sorted by t; '@n' = the n-th live pen entry. Priming size (penPrimeBelow) 2u unless 'rules' says otherwise. Never change an expectation without the user's OK.",
  "scenarios": [
    { "name": "user example: 1, 0.5, 8, 0.5 → 8.5u injected, 1.5u primed",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 0.5], ["13:02", 8], ["13:03", 0.5]] },
        { "expect": { "entries": [{ "k": "rapid", "t": "13:02", "a": 8.5, "pr": 1.5, "pen": "P1",
            "pd": [["13:00", 1, true], ["13:01", 0.5, true], ["13:02", 8, false], ["13:03", 0.5, false]] }],
          "questions": [], "report": { "created": 1, "logged": 8.5, "primed": 1.5 } } } ] },
    { "name": "user example: 1, 8 → 8u, 1u primed; priming combinations 0.5 ×3 then 6, 1.5 then 4",
      "steps": [
        { "scan": "P1", "at": "20:00", "add": [["12:00", 1], ["12:01", 8], ["13:00", 0.5], ["13:00:20", 0.5], ["13:00:40", 0.5], ["13:01", 6], ["19:00", 1.5], ["19:01", 4]] },
        { "expect": { "entries": [{ "t": "12:01", "a": 8, "pr": 1 }, { "t": "13:01", "a": 6, "pr": 1.5 }, { "t": "19:01", "a": 4, "pr": 1.5 }], "questions": [] } } ] },
    { "name": "split dose around a cartridge change: 5, 0.5, 0.5, 1, 3 → 8u injected, 2u primed",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 5], ["13:02", 0.5], ["13:02:30", 0.5], ["13:03", 1], ["13:04", 3]] },
        { "expect": { "entries": [{ "t": "13:00", "a": 8, "pr": 2,
            "pd": [["13:00", 5, false], ["13:02", 0.5, true], ["13:02:30", 0.5, true], ["13:03", 1, true], ["13:04", 3, false]] }] } } ] },
    { "name": "Novo's 2u flow checks: priming only with the size set above 2u (2.5); at the default they count",
      "rules": { "primeBelow": 2.5 },
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 2], ["13:00:30", 2], ["13:01", 2], ["13:02", 5]] },
        { "expect": { "entries": [{ "t": "13:02", "a": 5, "pr": 6 }], "questions": [] } } ] },
    { "name": "xDrip #4770: a run of 2u primes until the spray, the cartridge running out mid-dose (size 2.5): every prime counted, both parts injected",
      "rules": { "primeBelow": 2.5 },
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 2], ["13:00:20", 2], ["13:00:40", 2], ["13:01", 3], ["13:03", 2], ["13:03:30", 5]] },
        { "expect": { "entries": [{ "t": "13:01", "a": 8, "pr": 8 }], "questions": [] } } ] },
    { "name": "a 2u dose is not priming at the default size (2u = large)",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [["13:00", 2]] },
        { "expect": { "entries": [{ "t": "13:00", "a": 2, "pr": 0 }], "questions": [] } } ] },
    { "name": "two large doses: both injected, the small ones between them priming",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 4], ["13:02", 0.5], ["13:03", 8]] },
        { "expect": { "entries": [{ "t": "13:01", "a": 12, "pr": 1.5 }] } } ] },
    { "name": "small dose 40 min after an injection: asked (no top-up across sessions), suggestion injected",
      "steps": [
        { "scan": "P1", "at": "14:30", "add": [["13:00", 8], ["13:40", 1]] },
        { "expect": { "entries": [{ "t": "13:00", "a": 8 }], "questions": [{ "type": "doses", "doses": [["13:40", 1]], "suggest": [] }] } },
        { "answer": 0, "primed": [], "at": "14:31" },
        { "expect": { "entries": [{ "t": "13:00", "a": 8 }, { "t": "13:40", "a": 1, "pr": 0 }], "questions": [] } } ] },
    { "name": "priming then distraction: 1u, injection 25 min later",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [["13:00", 1], ["13:25", 6]] },
        { "expect": { "entries": [{ "t": "13:25", "a": 6, "pr": 1 }], "questions": [] } } ] },
    { "name": "small dose 45 min before an injection: a question",
      "steps": [
        { "scan": "P1", "at": "14:30", "add": [["13:00", 1], ["13:45", 6]] },
        { "expect": { "entries": [{ "t": "13:45", "a": 6, "pr": 0 }], "questions": [{ "type": "doses", "doses": [["13:00", 1]] }] } } ] },
    { "name": "two injections 40 min apart: the small dose between primes the second",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [["13:00", 8], ["13:30", 0.5], ["13:40", 4]] },
        { "expect": { "entries": [{ "t": "13:00", "a": 8, "pr": 0 }, { "t": "13:40", "a": 4, "pr": 0.5 }], "questions": [] } } ] },
    { "name": "all-small cluster → question suggesting the last dose injected; accepted",
      "steps": [
        { "scan": "P1", "at": "15:00", "add": [["13:02", 1], ["13:03", 1.5]] },
        { "expect": { "entries": [], "questions": [{ "type": "doses", "doses": [["13:02", 1], ["13:03", 1.5]], "suggest": ["13:02"] }], "report": { "asked": 1 } } },
        { "answer": 0, "suggested": true, "at": "15:01" },
        { "expect": { "entries": [{ "t": "13:03", "a": 1.5, "pr": 1 }], "questions": [] } } ] },
    { "name": "all-small answered all priming: no entry, Only priming in the history",
      "steps": [
        { "scan": "P1", "at": "15:00", "add": [["13:02", 1], ["13:03", 1.5]] },
        { "answer": 0, "primed": ["13:02", "13:03"], "at": "15:01" },
        { "expect": { "entries": [], "questions": [], "history": [{ "status": "priming", "pr": 2.5 }] } } ] },
    { "name": "open session grows between two scans: same entry, new version",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:00", 1], ["13:02", 8]] },
        { "expect": { "entries": [{ "id": "n1", "a": 8, "pr": 1 }] } },
        { "scan": "P1", "at": "13:07", "add": [["13:06", 0.5]] },
        { "expect": { "entries": [{ "id": "n1", "t": "13:02", "a": 8.5, "pr": 1 }], "writes": 1, "report": { "updated": 1, "created": 0, "logged": 0.5 } } } ] },
    { "name": "pending → question 30 min after its last dose",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["13:00", 1], ["13:00:30", 0.5]] },
        { "expect": { "entries": [], "questions": [], "report": { "pending": 2 }, "wake": "13:30:30" } },
        { "refresh": "13:31" },
        { "expect": { "questions": [{ "type": "doses", "doses": [["13:00", 1], ["13:00:30", 0.5]] }], "wake": null } } ] },
    { "name": "pending → priming when the injection follows",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["13:00", 1]] },
        { "scan": "P1", "at": "13:21", "add": [["13:20", 6]] },
        { "expect": { "entries": [{ "t": "13:20", "a": 6, "pr": 1 }], "questions": [] } } ] },
    { "name": "question from a timeout folds into an injection found later as its priming",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["13:00", 1]] },
        { "refresh": "13:31" },
        { "expect": { "questions": [{ "type": "doses" }] } },
        { "scan": "P1", "at": "14:00", "add": [["13:20", 6]] },
        { "expect": { "entries": [{ "t": "13:20", "a": 6, "pr": 1 }], "questions": [] } } ] },
    { "name": "first scan: 400 earlier doses stay out; the newest injection (< 24 h) is offered; nothing logged",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [{ "n": 400, "from": "D-40 08:00", "every": 8640, "a": 6 }] },
        { "expect": { "entries": [], "questions": [], "report": { "first": true, "older": 400, "created": 0, "offerA": 6 }, "pens": { "P1": { "since": "13:00", "older": 400 } } } },
        { "scan": "P1", "at": "14:00", "add": [["13:30", 1], ["13:31", 7]] },
        { "expect": { "entries": [{ "t": "13:31", "a": 7, "pr": 1 }], "report": { "first": false, "older": 0 } } } ] },
    { "name": "first scan right after injecting: Log it merges with the hand-typed copy",
      "first": true,
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "13:10" }],
      "steps": [
        { "scan": "P1", "at": "13:16", "add": [["D-3 08:00", 6], ["13:11", 0.5], ["13:12", 8], ["13:12:30", 0.5]] },
        { "expect": { "entries": [{ "id": "h1", "pen": null }], "report": { "older": 4, "offerA": 8.5, "offerMatch": "h1" } } },
        { "logOffer": true, "at": "13:17" },
        { "expect": { "entries": [{ "id": "h1", "t": "13:12", "a": 8.5, "pr": 0.5, "pen": "P1" }], "report": { "merged": 1 } } } ] },
    { "name": "first scan: an injection 2 days old is not offered",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [["D-2 12:00", 6]] },
        { "expect": { "report": { "offerA": null } } } ] },
    { "name": "rescan changes nothing",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:02", 8]] },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "entries": [{ "a": 8 }], "writes": 0, "report": { "created": 0, "updated": 0, "logged": 0 } } } ] },
    { "name": "duplicate record in the pen memory and 0u doses count once / never",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:02", 8], ["13:02", 8], ["13:03", 0]] },
        { "expect": { "entries": [{ "a": 8, "pr": 0, "pd": [["13:02", 8, false]] }] } } ] },
    { "name": "an incomplete dose counts with its reported units, is marked, never asks",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:02", 6.5, "inc"]] },
        { "expect": { "entries": [{ "a": 6.5, "pr": 1 }], "questions": [], "history": [{ "status": "logged", "a": 6.5, "incomplete": true }] } } ] },
    { "name": "delete then rescan: nothing comes back; history says Not logged",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:02", 8]] },
        { "delete": "@1", "at": "13:31" },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "entries": [], "questions": [], "writes": 0, "history": [{ "status": "not-logged", "a": 8 }] } } ] },
    { "name": "delete then the session grows: the new dose is asked",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:02", 8]] },
        { "delete": "@1", "at": "13:04" },
        { "scan": "P1", "at": "13:10", "add": [["13:08", 1]] },
        { "expect": { "entries": [], "questions": [{ "type": "doses", "doses": [["13:08", 1]] }] } } ] },
    { "name": "manual entry merge: the hand-typed 8u becomes the pen entry (id, note, origin kept)",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "13:05", "n": "lunch", "o": "mac" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8]] },
        { "expect": { "entries": [{ "id": "h1", "t": "13:01", "a": 8, "pr": 1, "pen": "P1", "n": "lunch", "o": "mac" }], "report": { "merged": 1, "created": 0 },
          "history": [{ "status": "merged", "a": 8 }] } } ] },
    { "name": "merge tolerance: 7.5u typed on the phone, pen 8.5u (within 1u) merges in place",
      "entries": [{ "id": "h1", "k": "rapid", "a": 7.5, "t": "12:40" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8.5]] },
        { "expect": { "entries": [{ "id": "h1", "a": 8.5, "pen": "P1" }] } } ] },
    { "name": "a writer's entry (caregiver, o follower) matched: tombstoned, a new pen entry of the wearer's takes its note; Undo brings it back",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "13:05", "n": "by Ana", "o": "follower" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8.5]] },
        { "expect": { "entries": [{ "id": "n1", "t": "13:01", "a": 8.5, "pen": "P1", "n": "by Ana", "o": "phone" }], "deleted": ["h1"], "report": { "merged": 1 },
          "history": [{ "status": "merged", "a": 8.5 }] } },
        { "undo": true, "at": "13:31" },
        { "expect": { "entries": [{ "id": "h1", "a": 8, "pen": null, "o": "follower" }] } } ] },
    { "name": "the amount edited by hand (a without pd) is a user edit: a rescan never reverts it, a dose joining it is asked",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:00", 1], ["13:02", 8]] },
        { "editA": "@1", "a": 7, "at": "13:04" },
        { "scan": "P1", "at": "13:05" },
        { "expect": { "entries": [{ "a": 7, "pr": 1 }], "writes": 0 } },
        { "scan": "P1", "at": "13:10", "add": [["13:07", 0.5]] },
        { "expect": { "entries": [{ "a": 7 }], "questions": [{ "type": "doses", "doses": [["13:07", 0.5]] }], "writes": 0 } } ] },
    { "name": "an oversized session (25 doses in one cluster) is split into entries of at most 20 doses",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [{ "n": 25, "from": "13:00", "every": 30, "a": 3 }] },
        { "expect": { "entries": [{ "a": 60, "pdCount": 20 }, { "a": 15, "pdCount": 5 }], "questions": [] } } ] },
    { "name": "two candidates → match question; nothing logged until answered; answered with the second",
      "entries": [{ "id": "h1", "k": "rapid", "a": 5, "t": "13:00" }, { "id": "h2", "k": "rapid", "a": 6, "t": "13:20" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:12", 8.5]] },
        { "expect": { "entries": [{ "id": "h1", "pen": null }, { "id": "h2", "pen": null }], "questions": [{ "type": "match", "doses": [["13:12", 8.5]], "cands": ["h2", "h1"] }] } },
        { "answer": 0, "same": "h2", "at": "13:31" },
        { "expect": { "entries": [{ "id": "h1", "pen": null, "t": "13:00" }, { "id": "h2", "t": "13:12", "a": 8.5, "pen": "P1" }], "questions": [] } } ] },
    { "name": "amount mismatch → match question; answered different injections",
      "entries": [{ "id": "h1", "k": "rapid", "a": 3, "t": "13:05" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:12", 8.5]] },
        { "expect": { "entries": [{ "id": "h1" }], "questions": [{ "type": "match", "cands": ["h1"] }] } },
        { "answer": 0, "different": true, "at": "13:31" },
        { "expect": { "entries": [{ "id": "h1", "a": 3, "pen": null }, { "t": "13:12", "a": 8.5, "pen": "P1" }], "questions": [] } } ] },
    { "name": "a session that grows while its match question is open waits with it",
      "entries": [{ "id": "h1", "k": "rapid", "a": 4, "t": "13:05" }],
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:00", 8]] },
        { "scan": "P1", "at": "13:10", "add": [["13:06", 1]] },
        { "expect": { "questions": [{ "type": "match", "doses": [["13:00", 8], ["13:06", 1]] }] } },
        { "answer": 0, "different": true, "at": "13:11" },
        { "expect": { "entries": [{ "t": "13:00", "a": 9, "pen": "P1" }, { "id": "h1" }] } } ] },
    { "name": "edit then the session grows: the entry stays, the new dose is asked",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:02", 8]] },
        { "edit": "@1", "n": "pizza", "at": "13:04" },
        { "scan": "P1", "at": "13:10", "add": [["13:08", 1]] },
        { "expect": { "entries": [{ "a": 8, "n": "pizza" }], "questions": [{ "type": "doses", "doses": [["13:08", 1]] }], "writes": 0 } } ] },
    { "name": "dose-role correction on the phone, then the session grows: correction kept, new dose asked",
      "steps": [
        { "scan": "P1", "at": "13:04", "add": [["13:00", 1], ["13:01", 0.5], ["13:02", 8], ["13:03", 0.5]] },
        { "correct": "@1", "primed": ["13:00", "13:01", "13:03"], "at": "13:05" },
        { "expect": { "entries": [{ "t": "13:02", "a": 8, "pr": 2 }], "history": [{ "status": "corrected", "a": 8, "pr": 2 }] } },
        { "scan": "P1", "at": "13:12", "add": [["13:09", 1]] },
        { "expect": { "entries": [{ "a": 8, "pr": 2 }], "questions": [{ "type": "doses", "doses": [["13:09", 1]] }], "writes": 0 } } ] },
    { "name": "dose-role correction on the other device (u unchanged here), then rescan: pd difference = edited",
      "steps": [
        { "scan": "P1", "at": "13:04", "add": [["13:00", 1], ["13:02", 8]] },
        { "correct": "@1", "primed": [], "keepU": true, "at": "13:05" },
        { "expect": { "entries": [{ "t": "13:00", "a": 9, "pr": 0 }] } },
        { "scan": "P1", "at": "13:12", "add": [["13:09", 1]] },
        { "expect": { "entries": [{ "a": 9, "pr": 0 }], "questions": [{ "type": "doses", "doses": [["13:09", 1]] }], "writes": 0 } } ] },
    { "name": "every dose set to priming: Remove from log, Only priming in the history; Undo puts it back",
      "steps": [
        { "scan": "P1", "at": "13:04", "add": [["13:00", 1], ["13:02", 8]] },
        { "correct": "@1", "primed": ["13:00", "13:02"], "expectNull": true, "at": "13:05" },
        { "remove": "@1", "at": "13:05" },
        { "expect": { "entries": [], "history": [{ "status": "priming", "pr": 9 }] } },
        { "restore": true, "at": "13:06" },
        { "expect": { "entries": [{ "t": "13:02", "a": 8, "pr": 1 }] } },
        { "scan": "P1", "at": "13:20" },
        { "expect": { "writes": 0, "questions": [] } } ] },
    { "name": "clock reset: known doses matched by time + units, nothing new logged on its own",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:02", 8]] },
        { "scan": "P1", "at": "14:00", "reset": true, "jitter": 20, "add": [["13:50", 4]] },
        { "expect": { "entries": [{ "a": 8, "pr": 1 }], "writes": 0, "questions": [], "report": { "clockChanged": true, "clockMatched": 2, "created": 0, "review": 1 } } },
        { "logReview": "P1", "at": "14:01" },
        { "expect": { "entries": [{ "a": 8 }, { "a": 4 }] } },
        { "scan": "P1", "at": "15:00", "add": [["14:30", 3]] },
        { "expect": { "entries": [{ "a": 8 }, { "a": 4 }, { "t": "14:30", "a": 3 }], "report": { "clockChanged": false, "created": 1 } } } ] },
    { "name": "big read: pen not scanned for 5 days logs at once (merges included) and is flagged for Review",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "D-4 13:05" }],
      "steps": [
        { "scan": "P1", "at": "D-5 09:00", "add": [["D-5 08:00", 6]] },
        { "scan": "P1", "at": "13:00", "add": [["D-4 13:00", 8], ["D-3 13:00", 7], ["D-1 13:00", 6], ["12:00", 5]] },
        { "expect": { "entries": [{ "t": "D-5 08:00" }, { "id": "h1", "t": "D-4 13:00", "pen": "P1" }, { "t": "D-3 13:00" }, { "t": "D-1 13:00" }, { "t": "12:00" }],
          "report": { "created": 3, "merged": 1, "bigSince": "D-4 13:00", "review": 0 } } },
        { "undo": true, "at": "13:01" },
        { "expect": { "entries": [{ "t": "D-5 08:00" }, { "id": "h1", "t": "D-4 13:05", "pen": null }] } } ] },
    { "name": "an everyday read is not flagged as big",
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [["D-1 13:00", 6], ["12:00", 5]] },
        { "expect": { "report": { "created": 2, "bigSince": null } } } ] },
    { "name": "after a clock reset: the waiting injections can be skipped, then logged one at a time",
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [["12:00", 5]] },
        { "scan": "P1", "at": "14:00", "reset": true, "add": [["13:30", 4]] },
        { "skipReview": "P1", "at": "14:01" },
        { "expect": { "entries": [{ "a": 5 }], "history": [{ "status": "not-logged", "a": 4 }, { "status": "logged", "a": 5 }] } },
        { "log": ["13:30"], "primed": [], "at": "14:02" },
        { "expect": { "entries": [{ "a": 5 }, { "a": 4 }] } } ] },
    { "name": "future dose (after scan + 2 min) is ignored and shown as such",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:02", 8], ["13:40", 5]] },
        { "expect": { "entries": [{ "a": 8 }], "report": { "future": 1 }, "history": [{ "status": "ignored", "a": 5 }, { "status": "logged", "a": 8 }] } } ] },
    { "name": "long pen: entries are long, matched only against long hand-typed entries",
      "pens": [{ "serial": "L1", "kind": "long" }],
      "entries": [{ "id": "r1", "k": "rapid", "a": 20, "t": "22:05" }, { "id": "l1", "k": "long", "a": 20, "t": "22:10" }],
      "steps": [
        { "scan": "L1", "at": "22:30", "add": [["22:00", 1], ["22:01", 20]] },
        { "expect": { "entries": [{ "id": "l1", "k": "long", "t": "22:01", "a": 20, "pr": 1, "pen": "L1" }, { "id": "r1", "pen": null }] } } ] },
    { "name": "two pens: rapid and long at the same meal stay apart",
      "pens": [{ "serial": "P1", "kind": "rapid" }, { "serial": "L1", "kind": "long" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 6]] },
        { "scan": "L1", "at": "13:31", "add": [["13:05", 18]] },
        { "expect": { "entries": [{ "k": "rapid", "a": 6, "pen": "P1" }, { "k": "long", "a": 18, "pen": "L1" }] } },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "writes": 0 } } ] },
    { "name": "reverse duplicate: a hand-typed entry near a pen entry of the same kind finds it",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:12", 8.5]] },
        { "near": { "k": "rapid", "t": "13:40" }, "is": "@1" },
        { "near": { "k": "rapid", "t": "14:00" }, "is": null },
        { "near": { "k": "long", "t": "13:12" }, "is": null } ] },
    { "name": "lost ledger (new phone): pen entries in the log are recognised, only newer doses import",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "09:00", "add": [{ "n": 50, "from": "D-10 08:00", "every": 17280, "a": 5 }] },
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8]] },
        { "lose": true },
        { "scan": "P1", "at": "18:00", "add": [["17:00", 0.5], ["17:01", 6]] },
        { "expect": { "entries": [{ "t": "13:01", "a": 8, "pr": 1 }, { "t": "17:01", "a": 6, "pr": 0.5 }],
          "report": { "first": true, "returning": true, "restored": 2, "created": 1, "offerA": null }, "pens": { "P1": { "since": "13:01" } } } } ] },
    { "name": "returning pen after 5 days: newer doses log at once, flagged as a big read",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "D-5 13:30", "add": [["D-5 13:01", 8]] },
        { "logOffer": true, "at": "D-5 13:31" },
        { "lose": true },
        { "scan": "P1", "at": "13:00", "add": [["D-4 13:00", 7], ["12:00", 5]] },
        { "expect": { "entries": [{ "t": "D-5 13:01" }, { "t": "D-4 13:00" }, { "t": "12:00" }], "report": { "returning": true, "created": 2, "bigSince": "D-4 13:00" } } } ] },
    { "name": "undo a read: the replaced hand-typed entry comes back; Log this injection brings the pen dose back",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "13:05", "n": "lunch" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8]] },
        { "undo": true, "at": "13:31" },
        { "expect": { "entries": [{ "id": "h1", "t": "13:05", "a": 8, "pen": null, "n": "lunch" }], "questions": [], "history": [{ "status": "not-logged", "a": 8, "pr": 1 }] } },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "writes": 0 } },
        { "log": ["13:00", "13:01"], "primed": ["13:00"], "at": "13:41" },
        { "expect": { "entries": [{ "id": "h1", "t": "13:01", "a": 8, "pr": 1, "pen": "P1", "n": "lunch" }] } } ] },
    { "name": "undo a read that created an entry: it is deleted",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8]] },
        { "undo": true, "at": "13:31" },
        { "expect": { "entries": [], "questions": [] } } ] },
    { "name": "Only priming, later logged as an injection from the history",
      "steps": [
        { "scan": "P1", "at": "15:00", "add": [["13:02", 1.5]] },
        { "answer": 0, "primed": ["13:02"], "at": "15:01" },
        { "scan": "P1", "at": "15:10" },
        { "expect": { "entries": [], "questions": [], "writes": 0 } },
        { "log": ["13:02"], "primed": [], "at": "15:11" },
        { "expect": { "entries": [{ "t": "13:02", "a": 1.5 }] } } ] },
    { "name": "a dose from before the start logged by hand (merges with its hand-typed twin)",
      "first": true,
      "entries": [{ "id": "h1", "k": "rapid", "a": 6, "t": "D-1 13:00" }],
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [["D-1 12:58", 6]] },
        { "expect": { "entries": [{ "id": "h1", "pen": null }], "report": { "older": 1 }, "history": [{ "status": "before", "a": 6 }] } },
        { "log": ["D-1 12:58"], "primed": [], "at": "13:01" },
        { "expect": { "entries": [{ "id": "h1", "t": "D-1 12:58", "pen": "P1" }] } } ] },
    { "name": "forget a pen, scan it again: it continues after its newest dose in the log (the deleted entry stays deleted)",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8]] },
        { "delete": "@1", "at": "13:31" },
        { "forget": "P1" },
        { "scan": "P1", "at": "14:00", "add": [["13:50", 4]] },
        { "expect": { "entries": [{ "t": "13:50", "a": 4 }], "report": { "first": true, "returning": true, "restored": 1, "created": 1 } } } ] },
    { "name": "forget a pen that has no entries: the next scan starts over",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "09:00", "add": [["D-1 13:01", 8]] },
        { "forget": "P1" },
        { "scan": "P1", "at": "14:00", "add": [["13:50", 4]] },
        { "expect": { "entries": [], "report": { "first": true, "returning": false, "older": 2 } } } ] }
  ]
}
