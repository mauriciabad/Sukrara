{
  "_doc": "Pen dose engine scenarios (DESIGN.md §3–§4.8). Run by spikes/novopen-android ScenarioTest and Sukrara's PenScenarioTest. Times: 'HH:MM[:SS]' on day D0 (2026-10-20 UTC) or 'D-n HH:MM'. A scan reads the pen's whole memory ('add' = doses dosed since the previous step). Expected entries = the live log sorted by t; '@n' = the n-th live pen entry. primeMax 2 u.",
  "scenarios": [
    { "name": "user example: 1, 0.5, 8, 0.5 → 8.5 u injected, 1.5 u primed",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 0.5], ["13:02", 8], ["13:03", 0.5]] },
        { "expect": { "entries": [{ "k": "rapid", "t": "13:02", "a": 8.5, "pr": 1.5, "pen": "P1",
            "pd": [["13:00", 1, true], ["13:01", 0.5, true], ["13:02", 8, false], ["13:03", 0.5, false]] }],
          "questions": [], "report": { "created": 1, "logged": 8.5, "primed": 1.5 } } } ] },
    { "name": "user priming combinations: 0.5 ×3 then 6; 1.5 then 4",
      "steps": [
        { "scan": "P1", "at": "20:00", "add": [["13:00", 0.5], ["13:00:20", 0.5], ["13:00:40", 0.5], ["13:01", 6], ["19:00", 1.5], ["19:01", 4]] },
        { "expect": { "entries": [{ "t": "13:01", "a": 6, "pr": 1.5 }, { "t": "19:01", "a": 4, "pr": 1.5 }], "questions": [] } } ] },
    { "name": "Novo flow check: 2 u (several after a cartridge change) is priming",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 2], ["13:00:30", 2], ["13:01", 2], ["13:02", 5]] },
        { "expect": { "entries": [{ "t": "13:02", "a": 5, "pr": 6 }], "questions": [] } } ] },
    { "name": "split dose: a dose above primeMax before the largest is injected, not priming",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 4], ["13:02", 8]] },
        { "expect": { "entries": [{ "t": "13:01", "a": 12, "pr": 1 }] } } ] },
    { "name": "top-up 40 min after the injection is added to it",
      "steps": [
        { "scan": "P1", "at": "14:30", "add": [["13:00", 8], ["13:40", 1]] },
        { "expect": { "entries": [{ "t": "13:00", "a": 9, "pr": 0 }], "questions": [] } } ] },
    { "name": "priming then distraction: 1 u, injection 25 min later",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [["13:00", 1], ["13:25", 6]] },
        { "expect": { "entries": [{ "t": "13:25", "a": 6, "pr": 1 }], "questions": [] } } ] },
    { "name": "small dose 45 min before an injection, nothing before: a question",
      "steps": [
        { "scan": "P1", "at": "14:30", "add": [["13:00", 1], ["13:45", 6]] },
        { "expect": { "entries": [{ "t": "13:45", "a": 6, "pr": 0 }], "questions": [{ "type": "doses", "doses": [["13:00", 1]] }] } } ] },
    { "name": "two injections 40 min apart: the small dose between primes the second",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [["13:00", 8], ["13:30", 0.5], ["13:40", 4]] },
        { "expect": { "entries": [{ "t": "13:00", "a": 8, "pr": 0 }, { "t": "13:40", "a": 4, "pr": 0.5 }], "questions": [] } } ] },
    { "name": "all-small isolated cluster → question; answered some of each",
      "steps": [
        { "scan": "P1", "at": "15:00", "add": [["13:02", 1], ["13:03", 1.5]] },
        { "expect": { "entries": [], "questions": [{ "type": "doses", "doses": [["13:02", 1], ["13:03", 1.5]] }], "report": { "asked": 1 } } },
        { "answer": 0, "primed": ["13:02"], "at": "15:01" },
        { "expect": { "entries": [{ "t": "13:03", "a": 1.5, "pr": 1 }], "questions": [] } } ] },
    { "name": "all-small answered all priming: no entry",
      "steps": [
        { "scan": "P1", "at": "15:00", "add": [["13:02", 1]] },
        { "answer": 0, "primed": ["13:02"], "at": "15:01" },
        { "expect": { "entries": [], "questions": [] } } ] },
    { "name": "lone 2 u injection (= flow check size) is asked, not guessed",
      "steps": [
        { "scan": "P1", "at": "14:00", "add": [["13:00", 2]] },
        { "expect": { "entries": [], "questions": [{ "type": "doses", "doses": [["13:00", 2]] }] } },
        { "answer": 0, "primed": [], "at": "14:01" },
        { "expect": { "entries": [{ "t": "13:00", "a": 2 }] } } ] },
    { "name": "open session grows between two scans: same entry, new version",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:00", 1], ["13:02", 8]] },
        { "expect": { "entries": [{ "id": "n1", "a": 8, "pr": 1 }] } },
        { "scan": "P1", "at": "13:07", "add": [["13:06", 0.5]] },
        { "expect": { "entries": [{ "id": "n1", "t": "13:02", "a": 8.5, "pr": 1 }], "writes": 1, "report": { "updated": 1, "created": 0, "logged": 0.5 } } } ] },
    { "name": "pending → question 30 min after its last dose",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["13:00", 1]] },
        { "expect": { "entries": [], "questions": [], "report": { "pending": 1 }, "wake": "13:30" } },
        { "refresh": "13:31" },
        { "expect": { "questions": [{ "type": "doses", "doses": [["13:00", 1]] }], "wake": null } } ] },
    { "name": "pending → priming when the injection follows",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["13:00", 1]] },
        { "scan": "P1", "at": "13:21", "add": [["13:20", 6]] },
        { "expect": { "entries": [{ "t": "13:20", "a": 6, "pr": 1 }], "questions": [] } } ] },
    { "name": "pending small dose after an injection becomes its top-up when nothing follows",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["12:30", 8], ["13:00", 1]] },
        { "expect": { "entries": [{ "a": 8 }], "report": { "pending": 1 } } },
        { "refresh": "13:31" },
        { "expect": { "entries": [{ "t": "12:30", "a": 9 }], "questions": [] } } ] },
    { "name": "question from a timeout folds into an injection found later as its priming",
      "steps": [
        { "scan": "P1", "at": "13:05", "add": [["13:00", 1]] },
        { "refresh": "13:31" },
        { "expect": { "questions": [{ "type": "doses" }] } },
        { "scan": "P1", "at": "14:00", "add": [["13:20", 6]] },
        { "expect": { "entries": [{ "t": "13:20", "a": 6, "pr": 1 }], "questions": [] } } ] },
    { "name": "first scan: 400 earlier doses stay in the pen, nothing imported",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [{ "n": 400, "from": "D-40 08:00", "every": 8640, "a": 6 }] },
        { "expect": { "entries": [], "questions": [], "report": { "first": true, "older": 400, "created": 0 }, "pens": { "P1": { "since": "13:00", "older": 400 } } } },
        { "scan": "P1", "at": "14:00", "add": [["13:30", 1], ["13:31", 7]] },
        { "expect": { "entries": [{ "t": "13:31", "a": 7, "pr": 1 }], "report": { "first": false, "older": 0 } } } ] },
    { "name": "rescan changes nothing",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:02", 8]] },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "entries": [{ "a": 8 }], "writes": 0, "report": { "created": 0, "updated": 0, "logged": 0 } } } ] },
    { "name": "duplicate record in the pen memory and 0 u doses count once / never",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:02", 8], ["13:02", 8], ["13:03", 0]] },
        { "expect": { "entries": [{ "a": 8, "pr": 0, "pd": [["13:02", 8, false]] }] } } ] },
    { "name": "delete then rescan: nothing comes back",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:02", 8]] },
        { "delete": "@1", "at": "13:31" },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "entries": [], "questions": [], "writes": 0 } } ] },
    { "name": "delete then the session grows: the new dose is asked",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:02", 8]] },
        { "delete": "@1", "at": "13:04" },
        { "scan": "P1", "at": "13:10", "add": [["13:08", 1]] },
        { "expect": { "entries": [], "questions": [{ "type": "doses", "doses": [["13:08", 1]] }] } } ] },
    { "name": "manual entry merge: the hand-typed 8 u becomes the pen entry (id, note, origin kept)",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "13:05", "n": "lunch", "o": "mac" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8]] },
        { "expect": { "entries": [{ "id": "h1", "t": "13:01", "a": 8, "pr": 1, "pen": "P1", "n": "lunch", "o": "mac" }], "report": { "merged": 1, "created": 0 } } } ] },
    { "name": "merge tolerance: 7.5 u typed, pen 8.5 u (within 1 u) merges; a caregiver's entry counts too",
      "entries": [{ "id": "h1", "k": "rapid", "a": 7.5, "t": "12:40", "o": "follower" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8.5]] },
        { "expect": { "entries": [{ "id": "h1", "a": 8.5, "pen": "P1" }] } } ] },
    { "name": "two candidates → match question; answered with the second",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "12:50" }, { "id": "h2", "k": "rapid", "a": 8, "t": "13:08" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 8]] },
        { "expect": { "entries": [{ "id": "h1", "pen": null }, { "id": "h2", "pen": null }], "questions": [{ "type": "match", "doses": [["13:00", 8]], "cands": ["h2", "h1"] }] } },
        { "answer": 0, "same": "h2", "at": "13:31" },
        { "expect": { "entries": [{ "id": "h1", "pen": null, "t": "12:50" }, { "id": "h2", "t": "13:00", "a": 8, "pen": "P1" }], "questions": [] } } ] },
    { "name": "amount mismatch → match question; answered different dose",
      "entries": [{ "id": "h1", "k": "rapid", "a": 4, "t": "13:05" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 8]] },
        { "expect": { "entries": [{ "id": "h1" }], "questions": [{ "type": "match", "cands": ["h1"] }] } },
        { "answer": 0, "different": true, "at": "13:31" },
        { "expect": { "entries": [{ "t": "13:00", "a": 8, "pen": "P1" }, { "id": "h1", "a": 4, "pen": null }], "questions": [] } } ] },
    { "name": "a session that grows while its match question is open waits with it",
      "entries": [{ "id": "h1", "k": "rapid", "a": 4, "t": "13:05" }],
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:00", 8]] },
        { "scan": "P1", "at": "13:10", "add": [["13:06", 1]] },
        { "expect": { "questions": [{ "type": "match", "doses": [["13:00", 8], ["13:06", 1]] }] } },
        { "answer": 0, "different": true, "at": "13:11" },
        { "expect": { "entries": [{ "t": "13:00", "a": 9, "pen": "P1" }, { "id": "h1" }] } } ] },
    { "name": "edit then the session grows: the entry stays, the new dose is asked",
      "steps": [
        { "scan": "P1", "at": "13:03", "add": [["13:02", 8]] },
        { "edit": "@1", "n": "pizza", "at": "13:04" },
        { "scan": "P1", "at": "13:10", "add": [["13:08", 1]] },
        { "expect": { "entries": [{ "a": 8, "n": "pizza" }], "questions": [{ "type": "doses", "doses": [["13:08", 1]] }], "writes": 0 } } ] },
    { "name": "dose-role correction on the phone, then the session grows: correction kept, new dose asked",
      "steps": [
        { "scan": "P1", "at": "13:04", "add": [["13:00", 1], ["13:01", 0.5], ["13:02", 8], ["13:03", 0.5]] },
        { "correct": "@1", "primed": ["13:00", "13:01", "13:03"], "at": "13:05" },
        { "expect": { "entries": [{ "t": "13:02", "a": 8, "pr": 2 }] } },
        { "scan": "P1", "at": "13:12", "add": [["13:09", 1]] },
        { "expect": { "entries": [{ "a": 8, "pr": 2 }], "questions": [{ "type": "doses", "doses": [["13:09", 1]] }], "writes": 0 } } ] },
    { "name": "dose-role correction on the other device (u unchanged here), then rescan: pd difference = edited",
      "steps": [
        { "scan": "P1", "at": "13:04", "add": [["13:00", 1], ["13:02", 8]] },
        { "correct": "@1", "primed": [], "keepU": true, "at": "13:05" },
        { "expect": { "entries": [{ "t": "13:00", "a": 9, "pr": 0 }] } },
        { "scan": "P1", "at": "13:12", "add": [["13:09", 1]] },
        { "expect": { "entries": [{ "a": 9, "pr": 0 }], "questions": [{ "type": "doses", "doses": [["13:09", 1]] }], "writes": 0 } } ] },
    { "name": "correction marks every dose priming: the app deletes the entry instead (correct() = null)",
      "steps": [
        { "scan": "P1", "at": "13:04", "add": [["13:00", 1], ["13:02", 8]] },
        { "correct": "@1", "primed": ["13:00", "13:02"], "expectNull": true, "at": "13:05" } ] },
    { "name": "dose history: change one dose of an entry to priming",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8], ["13:03", 0.5]] },
        { "set": "13:03", "role": "primed", "at": "13:31" },
        { "expect": { "entries": [{ "t": "13:01", "a": 8, "pr": 1.5 }] } },
        { "scan": "P1", "at": "13:40", "add": [["13:08", 1]] },
        { "expect": { "entries": [{ "a": 8 }], "questions": [{ "type": "doses" }] } } ] },
    { "name": "clock reset: known doses matched by time + units, nothing re-imported",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:02", 8]] },
        { "scan": "P1", "at": "14:00", "reset": true, "jitter": 20 },
        { "expect": { "entries": [{ "a": 8, "pr": 1 }], "writes": 0, "questions": [], "report": { "clockMatched": 2, "created": 0 } } },
        { "scan": "P1", "at": "15:00", "add": [["14:30", 4]] },
        { "expect": { "entries": [{ "a": 8 }, { "t": "14:30", "a": 4 }], "report": { "clockMatched": 0, "created": 1 } } } ] },
    { "name": "future dose (after scan + 2 min) is dropped",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:02", 8], ["13:40", 5]] },
        { "expect": { "entries": [{ "a": 8 }], "report": { "future": 1 } } } ] },
    { "name": "long pen: entries are long, matched only against long hand-typed entries",
      "pens": [{ "serial": "L1", "kind": "long" }],
      "entries": [{ "id": "r1", "k": "rapid", "a": 20, "t": "22:05" }, { "id": "l1", "k": "long", "a": 20, "t": "22:10" }],
      "steps": [
        { "scan": "L1", "at": "22:30", "add": [["22:00", 2], ["22:01", 20]] },
        { "expect": { "entries": [{ "id": "l1", "k": "long", "t": "22:01", "a": 20, "pr": 2, "pen": "L1" }, { "id": "r1", "pen": null }] } } ] },
    { "name": "two pens: rapid and long at the same meal stay apart",
      "pens": [{ "serial": "P1", "kind": "rapid" }, { "serial": "L1", "kind": "long" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 6]] },
        { "scan": "L1", "at": "13:31", "add": [["13:05", 18]] },
        { "expect": { "entries": [{ "k": "rapid", "a": 6, "pen": "P1" }, { "k": "long", "a": 18, "pen": "L1" }] } },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "writes": 0 } } ] },
    { "name": "reverse duplicate: a hand-typed entry near a pen entry of the same kind finds it",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:12", 8.5]] },
        { "near": { "k": "rapid", "t": "13:40" }, "is": "@1" },
        { "near": { "k": "rapid", "t": "14:00" }, "is": null },
        { "near": { "k": "long", "t": "13:12" }, "is": null } ] },
    { "name": "lost ledger (reinstall): pen entries in the log are recognised, only newer doses import",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "09:00", "add": [{ "n": 50, "from": "D-10 08:00", "every": 17280, "a": 5 }] },
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8]] },
        { "lose": true },
        { "scan": "P1", "at": "18:00", "add": [["17:00", 0.5], ["17:01", 6]] },
        { "expect": { "entries": [{ "t": "13:01", "a": 8, "pr": 1 }, { "t": "17:01", "a": 6, "pr": 0.5 }],
          "report": { "first": true, "restored": 2, "created": 1 }, "pens": { "P1": { "since": "13:01" } } } } ] },
    { "name": "undo a read: the merged hand-typed entry comes back; the doses can be logged again from the history",
      "entries": [{ "id": "h1", "k": "rapid", "a": 8, "t": "13:05", "n": "lunch" }],
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:00", 1], ["13:01", 8]] },
        { "undo": true, "at": "13:31" },
        { "expect": { "entries": [{ "id": "h1", "t": "13:05", "a": 8, "pen": null, "n": "lunch" }], "questions": [] } },
        { "scan": "P1", "at": "13:40" },
        { "expect": { "writes": 0 } },
        { "set": "13:01", "role": "injected", "at": "13:41" },
        { "expect": { "entries": [{ "id": "h1", "t": "13:01", "a": 8, "pen": "P1" }] } } ] },
    { "name": "undo a read that created an entry: it is deleted",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8]] },
        { "undo": true, "at": "13:31" },
        { "expect": { "entries": [], "questions": [] } } ] },
    { "name": "question dismissed (don't log), later logged from the history",
      "steps": [
        { "scan": "P1", "at": "15:00", "add": [["13:02", 1.5]] },
        { "dismiss": 0, "at": "15:01" },
        { "expect": { "entries": [], "questions": [] } },
        { "scan": "P1", "at": "15:10" },
        { "expect": { "questions": [], "writes": 0 } },
        { "set": "13:02", "role": "injected", "at": "15:11" },
        { "expect": { "entries": [{ "t": "13:02", "a": 1.5 }] } } ] },
    { "name": "a dose from before the start logged by hand from the history (merges with its hand-typed twin)",
      "first": true,
      "entries": [{ "id": "h1", "k": "rapid", "a": 6, "t": "D-1 13:00" }],
      "steps": [
        { "scan": "P1", "at": "13:00", "add": [["D-1 12:58", 6]] },
        { "expect": { "entries": [{ "id": "h1", "pen": null }], "report": { "older": 1 } } },
        { "set": "D-1 12:58", "role": "injected", "at": "13:01" },
        { "expect": { "entries": [{ "id": "h1", "t": "D-1 12:58", "pen": "P1" }] } } ] },
    { "name": "forget a pen, scan it again: it continues after its newest dose in the log (the deleted entry stays deleted)",
      "steps": [
        { "scan": "P1", "at": "13:30", "add": [["13:01", 8]] },
        { "delete": "@1", "at": "13:31" },
        { "forget": "P1" },
        { "scan": "P1", "at": "14:00", "add": [["13:50", 4]] },
        { "expect": { "entries": [{ "t": "13:50", "a": 4 }], "report": { "first": true, "restored": 1, "created": 1 } } } ] },
    { "name": "forget a pen that has no entries: the next scan starts over",
      "first": true,
      "steps": [
        { "scan": "P1", "at": "09:00", "add": [["D-1 13:01", 8]] },
        { "forget": "P1" },
        { "scan": "P1", "at": "14:00", "add": [["13:50", 4]] },
        { "expect": { "entries": [], "report": { "first": true, "older": 2 } } } ] }
  ]
}
